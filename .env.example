# Copy to .env in the repo root. Shared by server/ and client/.

# ---------- Server ----------
PORT=3001
# Comma-separated list of allowed dashboard origins
CORS_ORIGIN=http://localhost:5173

# Supabase (Project Settings -> API). The secret/service role key is server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Retell AI (Dashboard -> API Keys). RETELL_AGENT_ID is written by `npm run setup:retell`.
RETELL_API_KEY=your-retell-api-key
RETELL_AGENT_ID=your-agent-id
# Set to false only for local testing with curl (skips webhook signature checks)
RETELL_VERIFY_WEBHOOKS=true
# Emergency transfer target for the agent's escalate_call tool (E.164, e.g. +12135551234).
# Use a phone YOU control as stand-in dispatch. NEVER real 911. Leave empty to have the
# agent tell emergency callers to hang up and dial 911 instead. Rerun setup:retell after changing.
DISPATCH_TRANSFER_NUMBER=

# ---------- Dashboard (exposed to the browser: never put secret keys here) ----------
# Backend API. Leave empty in dev to use the Vite proxy (/api -> localhost:3001).
VITE_API_URL=
# Supabase public credentials for realtime. Use the publishable/anon key.
# If omitted, the dashboard falls back to polling the API every 5 seconds.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
